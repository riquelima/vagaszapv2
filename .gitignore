# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# vagas_compat_automation (local Python bot artifacts — keep code, ignore runtime data)
vagas_compat_automation/__pycache__/
vagas_compat_automation/.env
vagas_compat_automation/applied_jobs.json
vagas_compat_automation/applied_jobs.old.json
vagas_compat_automation/match_results.json
vagas_compat_automation/screenshots/
vagas_compat_automation/*.log
